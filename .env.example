# Yarin Portal environment settings.
# Copy this file to .env and fill in the values. Never commit .env.
#
# Make a random secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Admin panel (/admin) ---
ADMIN_PASSWORD=change-me

# --- Sessions: a long random string (at least 32 characters) that signs the login cookies ---
SESSION_SECRET=

# --- Database ---
# Production: the MongoDB Atlas connection string, for example
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# (Atlas -> Network Access must allow the server's IP address.)
# Local development: the MongoDB from compose.dev.yaml.
MONGO_URI=mongodb://localhost:27018
MONGO_DB=yarin_portal
# Only if Node.js cannot look up mongodb+srv:// addresses on your computer:
# DNS_SERVERS=1.1.1.1,8.8.8.8

# --- Vultr Object Storage (S3-compatible) for avatars, videos and files ---
S3_ENDPOINT=https://ams1.vultrobjects.com
S3_REGION=ams1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=yarin-portal

# --- Local development only ---
PORT=4100

# --- Production only: the local port of the web container (127.0.0.1:WEB_PORT) ---
WEB_PORT=8096
